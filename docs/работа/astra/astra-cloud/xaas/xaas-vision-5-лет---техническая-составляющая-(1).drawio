        <mxCell id="e1XRx1TT2TVfuU6P-dM--4" value="Здесь точкой приложения усилий и&amp;nbsp;&lt;br&gt;финальным предметом интереса&lt;br&gt;является самораспаковывающееся описания&lt;br&gt;(инсталлятор+кодовая база)&lt;br&gt;софтверной системы" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" parent="LC1PrdX8DKuaWEJOiBVR-6" vertex="1">
