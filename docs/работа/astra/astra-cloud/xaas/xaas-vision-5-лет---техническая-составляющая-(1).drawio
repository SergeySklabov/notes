        <mxCell id="SSzlrbjDVEa09GLxvASn-8" parent="SSzlrbjDVEa09GLxvASn-9" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" value="Здесь точкой приложения усилий и&lt;br&gt;финальным предметом интереса&lt;br&gt;является самораспаковывающееся описания&lt;br&gt;(инсталлятор+кодовая база)&lt;br&gt;софтверной системы" vertex="1">
