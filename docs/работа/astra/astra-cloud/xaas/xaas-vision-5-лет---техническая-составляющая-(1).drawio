        <mxCell id="lO0xeoLu19n7_uorJtgF-0" parent="gfUtXJWj5oBUdUeksLk1-1" style="text;whiteSpace=wrap;html=1;" value="&lt;b style=&quot;font-weight:normal;&quot; id=&quot;docs-internal-guid-479946d5-7fff-1a55-2c1f-04281dc60296&quot;&gt;&lt;span style=&quot;font-size:23pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:700;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;2029 - Зрелость и лидерство&lt;/span&gt;&lt;/b&gt;" vertex="1">
