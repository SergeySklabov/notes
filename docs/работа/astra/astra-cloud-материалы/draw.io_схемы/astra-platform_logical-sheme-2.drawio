          <mxGeometry height="60" width="120" x="-241.5" y="150" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-95" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="С учетом того, что пользователь уже авторизован с определенными правами, система дает (или наобот не дает, если в проекте он только вьюер) доступ к определенным организациям и проектам" vertex="1">
          <mxGeometry height="174" width="392.5" x="-440" y="246" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-96" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="С учетом того, что пользователь уже увторизован и имеет доступ к нужному проекту, где у него активирован требуемый сервис - он может через ЛК создать ВМ (со всеми необходимыми дополнительными компонентами - сети/бэкап/другое" vertex="1">
          <mxGeometry height="91" width="393.5" x="-441" y="439" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-97" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Система проверяет нет ли ограничений по квотам и хватает ли бюджета" vertex="1">
          <mxGeometry height="63" width="394" x="-442" y="556" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-98" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Оркестратор формирует план: - выделить IP (вызвать Network - создать том (вызвать Storage Service), - запустить инстанс (вызвать Compute Service) - поставить всё на тарификацию&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;(вызвать Billing) - о&lt;/span&gt;&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;тслеживает выполнение. В случае ошибки - сообщить&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="74" width="398" x="-440" y="630" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-99" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;С момента создания начинает собирать метрики (CPU, RAM, трафик) с этой VM.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="56" width="398" x="-435" y="732" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-100" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Принимает данные по потреблению и счиает стоимость использоания с учетом тарифа и возможных скидлк&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="56" width="398" x="-437" y="815" as="geometry" />
        </mxCell>
        <mxCell id="XlmlV0P0W74NIjYzk-QR-101" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Слой 11&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color: rgb(15, 17, 21); text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Бэкенд-сервисы платформы&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/span&gt;" vertex="1">
