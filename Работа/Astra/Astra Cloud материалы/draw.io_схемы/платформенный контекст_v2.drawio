            <mxPoint x="1129" y="2320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-61" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Клиент:&amp;nbsp;&lt;div&gt;Менеджер&lt;br&gt;&lt;div&gt;Непревередливый инженер, который решил идти не через CLI&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="25" x="-104" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Уже авторизован в ЛК в определенной роли, подразумевающий ряд прав" vertex="1">
          <mxGeometry height="60" width="181" x="-313" y="1672" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Заходит в ЛК, чтобы создать VM" vertex="1">
          <mxGeometry height="60" width="120" x="-151.5" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="С учетом того, что пользователь уже авторизован с определенными правами, система дает (или наобот не дает, если в проекте он только вьюер) доступ к определенным организациям и тенантам.&lt;div&gt;С учетом того, что пользователь уже увторизован и имеет доступ к нужному тенанту, где у него активирован требуемый сервис - он может через ЛК создать ВМ (со всеми необходимыми дополнительными компонентами - сети/бэкап/другое&lt;/div&gt;" vertex="1">
          <mxGeometry height="174" width="392.5" x="-345" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Платформа проверяет нет ли ограничений по квотам и хватает ли бюджета" vertex="1">
          <mxGeometry height="63" width="394" x="-352" y="2196" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Оркестратор формирует план: - выделить IP (вызвать Network - создать том (вызвать Storage Service), - запустить инстанс (вызвать Compute Service) - поставить всё на тарификацию&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;(вызвать Billing) - о&lt;/span&gt;&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;тслеживает выполнение. В случае ошибки - сообщить&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="74" width="398" x="-350" y="2270" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;С момента создания начинает собирать метрики (CPU, RAM, трафик) с этой VM.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="56" width="398" x="-345" y="2372" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(15, 17, 21); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;После запуска сущностей, данные по потреблению принимают в биллинг, который считает стоимость использованию с учетом тарифа и возможных скидок&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="56" width="398" x="-347" y="2455" as="geometry" />
        </mxCell>
        <mxCell id="bDVrLwXG1qpbMzoslJFv-70" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Компоненты&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color: rgb(15, 17, 21); text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Бэкенд-сервисы платформы&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="140" x="1320" y="2244" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
