        <mxCell id="VJ_dckDLqF3M8oeUzOZB-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="ДВИС" vertex="1">
          <mxGeometry height="60" width="120" x="240" y="230" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="ДВИС саппортит внешних клиентов и является:&lt;div&gt;L1- для Public&lt;div&gt;L2 - для On-prem&lt;div&gt;Они отрабатывают первые обращения - заводят заявки в Sirius&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="290" x="380" y="220" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;L2&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="245" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;L3&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="330" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;L4&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="500" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Команда L3 Александра Лещева" vertex="1">
          <mxGeometry height="60" width="120" x="240" y="315" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="В команде L3 Александра Лещева 2 человека - Денис Черкесов и Илья Устинов&lt;br&gt;&lt;div&gt;Они отрабатывают входящие запросы из Sirius на своем уровне.&lt;/div&gt;&lt;div&gt;Если на своем уровне решить не могут - декомпазируют задачу по компонентам (Брест, IAM, SDN, BillManager, AstraMonitoiring) и заводят в AIC Bug линкуя с изночальным запросом из Sirius&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="430" x="380" y="305" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Команда Astra Cloud Platform" vertex="1">
          <mxGeometry height="60" width="120" x="240" y="485" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Команда платформы рассматривает тикет в AIC Bug - ТПМ компонента платформы рассматривает его и принимает решение&amp;nbsp;&lt;div&gt;- есть такой-то обход&lt;/div&gt;&lt;div&gt;- данная возможность уже запланирована в релизе X&lt;/div&gt;&lt;div&gt;- данная возможность не запланирована - берем в проработку&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- данная возможность будет реализована в релизе Y&lt;/div&gt;&lt;div&gt;-- данная возможность не целесообразна к реализации в рамках продукта&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="430" x="80" y="600" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Команда&amp;nbsp; Компоненты (например Bootsman)" vertex="1">
          <mxGeometry height="60" width="120" x="510" y="485" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Команда компоненты рассматривает тикет в своем баг-треккера&amp;nbsp; и принимает решение&amp;nbsp;&lt;div&gt;- есть такой-то обход&lt;/div&gt;&lt;div&gt;- данная возможность уже запланирована в релизе X&lt;/div&gt;&lt;div&gt;- данная возможность не запланирована - берем в проработку&amp;nbsp;&lt;/div&gt;&lt;div&gt;-- данная возможность будет реализована в релизе Y&lt;/div&gt;&lt;div&gt;-- данная возможность не целесообразна к реализации в рамках продукта&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="430" x="550" y="600" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Где заводятся/будут заводится тикеты для компонент?&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="650" y="485" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;На каком этапе подключается On-prem/Publuc в контексте валидации вхоядещего запроса от клиентов?&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="1260" y="310" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;font color=&quot;#ff0000&quot;&gt;&amp;nbsp;ПСБ идет по пути поддержки продукта (как описано ниже) и как проект?&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="780" y="-160" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;font color=&quot;#ff0000&quot;&gt;Если как проект -&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;- Как осуществляется вазимодействие с клиентом?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;- Как осуществляется взаимодействие с командами других компонент в рамках проектной реализации?&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="360" x="-250" y="-80" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Команда Михаила Кочеткова саппортит внешних клиентов и является L1&lt;div&gt;Они отрабатывают первые обращения в Sirius (но это другое пространство - не то чем пользуется ДВИС)&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="290" x="380" y="120" as="geometry" />
        </mxCell>
        <mxCell id="VJ_dckDLqF3M8oeUzOZB-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;В каком случае запрос идет через ДВИС а в каком через команду Михаила Кочеткова?&lt;/font&gt;" vertex="1">
